{
    "name":  "@xingruochun/dsh-rea",
    "version":  "1.0.3",
    "type":  "module",
    "description":  "REA (Reverse Engineer Anything) inside DSH: 170 reverse-engineering tools as mcp__rea__*, served by a local stdio MCP process. Binaries never leave your machine.",
    "icon":  "icon.svg",
    "license":  "MIT",
    "author":  "xingruochun",
    "files":  [
                  "index.js",
                  "cordis.patch.yml",
                  "icon.svg",
                  "locale/",
                  "README.md",
                  "LICENSE"
              ],
    "dsh":  {
                "manifestVersion":  1,
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/xingruochun/dsh-rea.git"
                   },
    "homepage":  "https://github.com/xingruochun/dsh-rea#readme",
    "bugs":  {
                 "url":  "https://github.com/xingruochun/dsh-rea/issues"
             },
    "keywords":  [
                     "dsh",
                     "dsh-plugin",
                     "dsh-plugins",
                     "deepseek-harness",
                     "cordis",
                     "mcp",
                     "rea",
                     "reverse-engineering"
                 ],
    "dependencies":  {
                         "rea-agents":  "^6.7.0"
                     },
    "peerDependencies":  {
                             "@deepseek-ai/dsh-mcp-client":  "\u003e=0.1.0-rc.8"
                         },
    "peerDependenciesMeta":  {
                                 "@deepseek-ai/dsh-mcp-client":  {
                                                                     "optional":  true
                                                                 }
                             },
    "engines":  {
                    "node":  "\u003e=20.0.0"
                },
    "main":  "index.js",
    "exports":  {
                    ".":  "./index.js",
                    "./cordis.patch.yml":  "./cordis.patch.yml",
                    "./package.json":  "./package.json"
                },
    "publishConfig":  {
                          "access":  "public",
                          "registry":  "https://registry.npmjs.org/"
                      }
}